# Local mode only. Copy to .env and change the token.
MIA_DEV_TOKEN=replace-with-a-long-random-string-of-24-plus-chars
# rose (English) or rose-de (German)
MIA_PROFILE=rose
PORT=8787
MIA_DATA_DIR=.mia-data

# Mia Voice (local mode)
# ANTHROPIC_API_KEY=  ← set in your shell from your keys CLI, or here in .env (never commit .env)
# MIA_MODEL=claude-sonnet-5-5
# LLM_PROVIDER=anthropic|featherless|openai   ← default: anthropic if ANTHROPIC_API_KEY is set, else featherless
# FEATHERLESS_API_KEY=   ← featherless default model: openai/gpt-oss-120b (MIA_MODEL=moonshotai/Kimi-K2-Instruct-0905 is faster, less reliable)
# LLM_BASE_URL=   ← openai provider only (e.g. https://api.openai.com/v1); also needs LLM_API_KEY and MIA_MODEL
#                  a MIA_MODEL containing "gpt-oss" (any case) is sent reasoning_effort "low": the backend must accept it
# LLM_API_KEY=
VOICE_PORT=8788
# MIA_MCP_URL=  ← leave unset to start Mia in-process
